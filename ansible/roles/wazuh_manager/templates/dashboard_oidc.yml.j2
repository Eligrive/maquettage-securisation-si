# SSO Keycloak (OpenID Connect) — acces dashboard reserve a Equipe_DSI.
# NB : le dashboard Wazuh (OpenSearch Dashboards 2.13) n'accepte auth.type qu'en
# STRING (le multi-auth ["basic","openid"] casse le demarrage : « expected value
# of type [string] but got [Array] »). On force donc OIDC seul. Filet de secours
# en cas de SSO HS : retirer ce bloc + restart -> retour au formulaire basic.
opensearch_security.auth.type: "openid"
opensearch_security.openid.connect_url: "{{ wazuh_sso_connect_url }}"
opensearch_security.openid.client_id: "{{ wazuh_sso_client_id }}"
opensearch_security.openid.client_secret: "{{ wazuh_sso_client_secret }}"
opensearch_security.openid.base_redirect_url: "{{ wazuh_sso_base_redirect_url }}"
opensearch_security.openid.scope: "{{ wazuh_sso_scope }}"
opensearch_security.openid.verify_hostnames: true
opensearch_security.openid.root_ca: "{{ wazuh_sso_dashboard_root_ca }}"
